# =====================================================================
# Pod Life — Environment Variables
# Copy to .env and fill in. Never commit .env.
#
# Two deployment targets are supported, picked at runtime by env vars:
#   - SELF-HOSTED   (Docker / VPS / Railway full-stack)
#       → DATABASE_URL points at your Postgres
#       → REDIS_URL points at your Redis
#       → OPTIMIZER_URL points at your Python optimizer
#       → SMTP_HOST set OR no email config (dev banner)
#       → no Upstash / QStash / Resend / Vercel vars
#   - SERVERLESS    (Vercel + Neon + Upstash + Resend + Railway optimizer)
#       → DATABASE_URL points at Neon (auto-detected by *.neon.tech)
#       → UPSTASH_REDIS_REST_URL set        → Upstash transport
#       → QSTASH_TOKEN set                  → QStash queue
#       → RESEND_API_KEY set                → Resend email
#       → CRON_SECRET set                   → Vercel Cron auth
#       → OPTIMIZER_URL points at Railway-hosted Python optimizer
# =====================================================================

# ─── Core ────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ─── Database ───────────────────────────────────────────────────────
# Self-hosted: postgresql://podlife:podlife@localhost:5433/podlife
# Serverless:  postgresql://USER:PASS@ep-xxx.us-east-1.aws.neon.tech/podlife?sslmode=require
DATABASE_URL=postgresql://podlife:podlife@localhost:5433/podlife
DB_PASSWORD=podlife

# ─── Redis ──────────────────────────────────────────────────────────
# Self-hosted (set REDIS_URL):
REDIS_URL=redis://localhost:6380
# Serverless (set both UPSTASH_* values; REDIS_URL is ignored):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Job Queue (serverless only) ────────────────────────────────────
# When unset, BullMQ workers run in-process against REDIS_URL.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ─── Vercel Cron (serverless only) ──────────────────────────────────
# Shared secret Vercel sends as `Bearer <CRON_SECRET>` to /api/cron/*.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# ─── Encryption (REQUIRED — generate with: openssl rand -hex 32) ────
# 32-byte hex string. If lost, all stored OAuth tokens are unrecoverable.
ENCRYPTION_KEY=replace_with_openssl_rand_hex_32_output_64_hex_chars_total_xx

# ─── Optimizer ──────────────────────────────────────────────────────
# Default: inline WASM HiGHS in apps/api/src/services/optimizer/. No URL
# needed. Set OPTIMIZER_HTTP=1 to opt back into the legacy Python service
# at OPTIMIZER_URL (e.g. for parity-testing the inline port).
OPTIMIZER_HTTP=
OPTIMIZER_URL=http://localhost:8000

# ─── Email (magic links) ────────────────────────────────────────────
# In development, magic links are also logged to the API console.
# Transport priority: RESEND_API_KEY > SMTP_HOST > console banner.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=hello@podlife.local

# ─── Google Calendar OAuth ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Microsoft / Outlook OAuth ──────────────────────────────────────
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common

# ─── Telegram Bot ───────────────────────────────────────────────────
# All four are optional. If TELEGRAM_BOT_TOKEN is unset, the bot subsystem
# is fully disabled (no commands, no DMs, no group notifications). The link
# routes return 503, the notification service skips telegram silently.
#
# Get the bot token from @BotFather on Telegram. After creating, set the
# bot username (without leading @) here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=pod_life_bot

# Random hex string sent in the URL path AND in the X-Telegram-Bot-Api-Secret-Token
# header. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Public HTTPS URL Telegram should POST to. Should end with the secret value
# above, e.g. https://api.example.com/telegram/webhook/<secret>.
# Used only by the one-shot `pnpm --filter @pod-life/api telegram:set-webhook`
# script.
TELEGRAM_WEBHOOK_URL=

# ─── Anthropic Claude (AI features — optional) ─────────────────────
ANTHROPIC_API_KEY=
