{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm --filter @pod-life/shared build && pnpm --filter @pod-life/api build && mkdir -p public",
  "outputDirectory": "public",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    {
      "path": "/api/cron/auto-lock",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/weekly-cycle",
      "schedule": "0 20 * * 0"
    }
  ]
}
