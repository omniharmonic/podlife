{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm --filter @pod-life/shared build && pnpm --filter @pod-life/api build && pnpm --filter @pod-life/api migrate:if-prod && pnpm --filter @pod-life/web build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/.pnpm/highs@*/node_modules/highs/build/**"
    }
  },
  "rewrites": [
    { "source": "/api/cron/:path*", "destination": "/api/index" },
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/auth/:path*", "destination": "/api/index" },
    { "source": "/internal/:path*", "destination": "/api/index" },
    { "source": "/telegram/webhook/:path*", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/((?!api/|auth/|internal/|telegram/|health|assets/|.*\\..*).*)", "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/auto-lock",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/weekly-cycle",
      "schedule": "0 20 * * 0"
    }
  ]
}
